{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/santorini", "destination": "/public/santorini.html" },
    { "source": "/mallorca", "destination": "/public/mallorca.html" },
    { "source": "/kroatien", "destination": "/public/kroatien.html" },
    { "source": "/(.*)", "destination": "/public/index.html" }
  ]
}