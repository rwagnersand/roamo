{
  "headers": [
    {
      "source": "/blog/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "text/html; charset=utf-8" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/blog/(.*)", "destination": "/blog/$1.html" },
    { "source": "/(.*)", "destination": "/public/index.html" }
  ]
}